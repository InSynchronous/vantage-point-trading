# VantagePoint Trading - env template
# Copy to .env.local and fill in. App works fully with mocks when empty.

# -- Research agent (Python FastAPI + SQLite, runs on this machine) --
# Terminal 1: npm run dev        (Next.js app, :3000)
# Terminal 2: npm run research   (agent worker + API, :8100)
NEXT_PUBLIC_RESEARCH_API_URL=http://localhost:8100

# -- Web search (Exa - server-side key, used by the research agent) --
EXA_API_KEY=

# -- FRED (Federal Reserve Economic Data - free key) --
# Powers the Economic Indicators node + historical macro in backtests.
FRED_KEY=

# -- AI (opencode Go - OpenAI-compatible inference) --
# Browser calls same-origin /api/ai/analyze proxy - key stays server-side.
# Do NOT create NEXT_PUBLIC_AI_BASE_URL; it would be read as a URL.
# NOTE: /zen/go/v1 is the agent auth flow, NOT inference. Inference base is:
#   https://opencode.ai/inference/go/openai/v1
# (code maps zen→inference automatically, but prefer the right value here)
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_API_KEY=
# Must be a real Go model ID using chat/completions, e.g. glm-5.3-flash, kimi-k3,
# deepseek-v4.1-flash, qwen3.8-flash. ("opencode-default" is not a model.)
# Muse Spark models use the /responses API instead - not supported by this client yet.
AI_MODEL=glm-5.3-flash
NEXT_PUBLIC_AI_CONFIGURED=

# -- Trading data (Alpaca - PAPER ONLY enforced in code) --
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
NEXT_PUBLIC_ALPACA_CONFIGURED=

# Safety: never set LIVE_TRADING=1 - engine ignores it and stays on paper.
LIVE_TRADING=0
